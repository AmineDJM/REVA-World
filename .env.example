# Local-only example. Never copy these passwords to production.
REVA_ENV=local
REVA_LOG_LEVEL=INFO
REVA_MIGRATION_DATABASE_URL=postgresql://reva_owner:local_reva_owner_only@127.0.0.1:5432/reva
REVA_DB_HOST=127.0.0.1
REVA_DB_PORT=5432
REVA_DB_NAME=reva
REVA_API_DB_PASSWORD=local_api_only
REVA_WORKER_DB_PASSWORD=local_worker_only
REVA_SIM_DB_PASSWORD=local_sim_only
REVA_DB_POOL_SIZE=2
REVA_DB_MAX_OVERFLOW=0
REVA_DB_STATEMENT_TIMEOUT_MS=10000
# TLS to PostgreSQL (libpq sslmode). Production REQUIRES one of: require | verify-ca | verify-full
# (verify-full recommended). Leave unset locally (the docker database has no TLS).
# REVA_DB_SSLMODE=verify-full
# Process role: api | worker | sim | bootstrap. When set, Settings enforces that role's production
# requirements at load time (api: REVA_API_DB_PASSWORD, REVA_SESSION_SECRET>=32 chars, Argon2id
# REVA_ADMIN_PASSWORD_HASH, public REVA_ALLOWED_HOSTS; worker: REVA_WORKER_DB_PASSWORD +
# REVA_SIM_DB_PASSWORD, no session secret needed; sim: REVA_SIM_DB_PASSWORD; runtime roles must not
# see REVA_MIGRATION_DATABASE_URL; bootstrap: REVA_MIGRATION_DATABASE_URL + all three role passwords).
# Set by the start scripts; leave unset for local CLI use.
# REVA_PROCESS_ROLE=worker
REVA_OBJECT_BACKEND=filesystem
REVA_OBJECT_ROOT=./var/objects
REVA_S3_PREFIX=reva/
REVA_SESSION_SECRET=replace_with_a_random_local_secret_before_login
# Generate with the implemented command: uv run reva auth hash-password
REVA_ADMIN_PASSWORD_HASH=
REVA_PUBLIC_BASE_URL=http://localhost:8000
REVA_ALLOWED_HOSTS=localhost,127.0.0.1
REVA_CORS_ORIGINS=http://localhost:5173
REVA_WORKER_CONCURRENCY=1
REVA_JOB_LEASE_SECONDS=120
REVA_JOB_HEARTBEAT_SECONDS=30
REVA_JOB_MAX_ATTEMPTS=5
REVA_SCHEDULER_TICK_SECONDS=30
REVA_CPU_BUDGET_THREADS=1
REVA_DUCKDB_MEMORY_LIMIT=256MB
REVA_HTTP_TIMEOUT_SECONDS=30
REVA_HTTP_MAX_BYTES=52428800
REVA_HTTP_CONTACT_EMAIL=
# Outbound HTTP egress for connectors: direct (DNS-pinned connection to the vetted address; default
# when REVA_ENV=production) | env (use HTTPS_PROXY/NO_PROXY from the environment; default locally).
# With env the egress proxy resolves names, so it must enforce the allowlist and private-range deny.
# REVA_HTTP_PROXY_MODE=env
REVA_CACHE_MAX_BYTES=536870912
REVA_LLM_ENABLED=false
REVA_LLM_MONTHLY_BUDGET_USD=0
REVA_AUTONOMY_MODE=template_only
REVA_AUTONOMY_KILL_SWITCH=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
POLARS_MAX_THREADS=1
