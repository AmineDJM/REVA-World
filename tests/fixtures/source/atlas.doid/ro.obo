[Typedef]
id: RO:0004019
name: disease has basis in
domain: OGMS:0000031 ! disease
is_a: RO:0004017 ! realizable has basis in
is_a: RO:0004023 ! causal relationship with disease as subject
created_by: https://orcid.org/0000-0002-6601-2165
