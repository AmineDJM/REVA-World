# Secrets and local state never enter the build context.
# (.dockerignore patterns are anchored at the context root: ** reaches nested files.)
**/.env
**/.env.*
!.env.example
var/
**/*.pem
**/*.key
**/*.p12
**/id_rsa*
**/id_ed25519*

# VCS, tooling, caches
.git/
.github/
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.grimp_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
.claude/
**/node_modules/
*.egg-info/
build/
dist/

# Built in the ui stage from the lockfile; never copied from the host.
ui/node_modules/
ui/dist/
ui/test-results/
ui/playwright-report/
src/reva/api/static/

# Not needed at runtime (tests/fixtures are test_fixture origin and never published in production).
tests/
docs/
schema/
compose.yaml
Makefile
# Local-development only (drops the local database; hardcodes the local owner password).
scripts/dev_reset_db.sh
