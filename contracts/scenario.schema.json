{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REVA ScenarioSpec v2.0.0 \u2014 discriminated union on model_key",
  "description": "Common fields are shared by every model; intervention, assumptions and outputs (and any narrower common field) come from the model plugin's spec_schema(). Crude-exposure specs with schema_version 1.0.0 (the V1 appendix, contracts/scenario.v1.schema.json) remain valid. Generated by `python -m reva.simulation.scenario_schema`; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_key"
  ],
  "properties": {
    "schema_version": {},
    "title": {},
    "baseline_release_id": {},
    "knowledge_cutoff": {},
    "model_key": {
      "enum": [
        "economic.crude_exposure"
      ]
    },
    "model_version": {},
    "countries": {},
    "reference_year": {},
    "horizon": {},
    "intervention": {},
    "assumptions": {},
    "fidelity": {},
    "missing_input_policy": {},
    "outputs": {},
    "seed": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_key": {
            "const": "economic.crude_exposure"
          }
        },
        "required": [
          "model_key"
        ]
      },
      "then": {
        "$ref": "#/$defs/economic.crude_exposure"
      }
    }
  ],
  "$defs": {
    "economic.crude_exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0",
            "2.0.0"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseline_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "model_key": {
          "const": "economic.crude_exposure"
        },
        "model_version": {
          "const": "1.0.0"
        },
        "countries": {
          "type": "array",
          "items": {
            "enum": [
              "FRA",
              "DZA",
              "CHN",
              "USA"
            ]
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "reference_year": {
          "type": "integer",
          "minimum": 2020,
          "maximum": 2024
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periods": {
              "const": 1
            },
            "unit": {
              "const": "annual_accounting_period"
            }
          },
          "required": [
            "periods",
            "unit"
          ]
        },
        "intervention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "set_exogenous_border_price_multiplier"
            },
            "import_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "export_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "unit": {
              "const": "ratio"
            }
          },
          "required": [
            "kind",
            "import_multiplier",
            "export_multiplier",
            "unit"
          ]
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quantity_response": {
              "enum": [
                "fixed",
                "elasticity_sensitivity"
              ]
            },
            "elasticity_grid": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "import_elasticity": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 1
                  },
                  "export_elasticity": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 2
                  },
                  "basis": {
                    "const": "scenario_assumption"
                  }
                },
                "required": [
                  "import_elasticity",
                  "export_elasticity",
                  "basis"
                ]
              }
            },
            "no_general_equilibrium": {
              "const": true
            }
          },
          "required": [
            "quantity_response",
            "elasticity_grid",
            "no_general_equilibrium"
          ]
        },
        "fidelity": {
          "enum": [
            "L0",
            "L1",
            "L2"
          ]
        },
        "missing_input_policy": {
          "const": "fail"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "import_value_change_usd",
              "export_value_change_usd",
              "net_external_cost_change_usd",
              "exposure_percent_baseline_gdp"
            ]
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "title",
        "baseline_release_id",
        "knowledge_cutoff",
        "model_key",
        "model_version",
        "countries",
        "reference_year",
        "horizon",
        "intervention",
        "assumptions",
        "fidelity",
        "missing_input_policy",
        "outputs",
        "seed"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "L1"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "properties": {
                  "quantity_response": {
                    "const": "fixed"
                  },
                  "elasticity_grid": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "L2"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "properties": {
                  "quantity_response": {
                    "const": "elasticity_sensitivity"
                  },
                  "elasticity_grid": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
