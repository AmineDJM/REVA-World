{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REVA ScenarioSpec v2.0.0 \u2014 discriminated union on model_key",
  "description": "Common fields are shared by every model; intervention, assumptions and outputs (and any narrower common field) come from the model plugin's spec_schema(). Crude-exposure specs with schema_version 1.0.0 (the V1 appendix, contracts/scenario.v1.schema.json) remain valid. Generated by `python -m reva.simulation.scenario_schema`; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_key"
  ],
  "properties": {
    "schema_version": {},
    "title": {},
    "baseline_release_id": {},
    "knowledge_cutoff": {},
    "model_key": {
      "enum": [
        "demography.cohort_component",
        "economic.crude_exposure",
        "economic.io_price",
        "social.retirement_age"
      ]
    },
    "model_version": {},
    "countries": {},
    "reference_year": {},
    "horizon": {},
    "intervention": {},
    "assumptions": {},
    "fidelity": {},
    "missing_input_policy": {},
    "outputs": {},
    "seed": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_key": {
            "const": "demography.cohort_component"
          }
        },
        "required": [
          "model_key"
        ]
      },
      "then": {
        "$ref": "#/$defs/demography.cohort_component"
      }
    },
    {
      "if": {
        "properties": {
          "model_key": {
            "const": "economic.crude_exposure"
          }
        },
        "required": [
          "model_key"
        ]
      },
      "then": {
        "$ref": "#/$defs/economic.crude_exposure"
      }
    },
    {
      "if": {
        "properties": {
          "model_key": {
            "const": "economic.io_price"
          }
        },
        "required": [
          "model_key"
        ]
      },
      "then": {
        "$ref": "#/$defs/economic.io_price"
      }
    },
    {
      "if": {
        "properties": {
          "model_key": {
            "const": "social.retirement_age"
          }
        },
        "required": [
          "model_key"
        ]
      },
      "then": {
        "$ref": "#/$defs/social.retirement_age"
      }
    }
  ],
  "$defs": {
    "demography.cohort_component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseline_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "model_key": {
          "const": "demography.cohort_component"
        },
        "model_version": {
          "const": "1.0.0"
        },
        "countries": {
          "type": "array",
          "items": {
            "enum": [
              "AUT",
              "BEL",
              "BGR",
              "CHE",
              "CYP",
              "CZE",
              "DEU",
              "DNK",
              "ESP",
              "EST",
              "FIN",
              "FRA",
              "GRC",
              "HRV",
              "HUN",
              "IRL",
              "ISL",
              "ITA",
              "LIE",
              "LTU",
              "LUX",
              "LVA",
              "MLT",
              "NLD",
              "NOR",
              "POL",
              "PRT",
              "ROU",
              "SVK",
              "SVN",
              "SWE"
            ]
          },
          "minItems": 1,
          "maxItems": 31,
          "uniqueItems": true
        },
        "reference_year": {
          "type": "integer",
          "minimum": 2001,
          "maximum": 2100
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "periods",
            "unit"
          ],
          "properties": {
            "periods": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "unit": {
              "const": "calendar_year"
            }
          }
        },
        "intervention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "baseline_projection"
            }
          }
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mortality",
            "fertility",
            "migration",
            "base_period"
          ],
          "properties": {
            "mortality": {
              "enum": [
                "constant_base_period_rates"
              ]
            },
            "fertility": {
              "enum": [
                "constant_base_period_rates",
                "europop2023_bsl"
              ]
            },
            "migration": {
              "enum": [
                "zero",
                "average_residual",
                "europop2023_bsl"
              ]
            },
            "base_period": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_year",
                "last_year"
              ],
              "properties": {
                "first_year": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100
                },
                "last_year": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100
                }
              }
            },
            "migration_window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "first_year",
                "last_year"
              ],
              "properties": {
                "first_year": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100
                },
                "last_year": {
                  "type": "integer",
                  "minimum": 1990,
                  "maximum": 2100
                }
              }
            },
            "migration_breaks": {
              "enum": [
                "exclude",
                "include"
              ]
            },
            "allow_single_year_migration": {
              "type": "boolean"
            },
            "sensitivity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "migration",
                "fertility"
              ],
              "properties": {
                "migration": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "zero",
                      "average_residual",
                      "europop2023_bsl"
                    ]
                  }
                },
                "fertility": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "constant_base_period_rates",
                      "europop2023_bsl"
                    ]
                  }
                }
              }
            }
          }
        },
        "fidelity": {
          "enum": [
            "L0",
            "L1",
            "L2"
          ]
        },
        "missing_input_policy": {
          "enum": [
            "fail",
            "skip_missing_countries"
          ]
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "population.total.all_ages",
              "population.total.age_0_14",
              "population.total.age_15_64",
              "population.total.age_65_plus",
              "population.total.age_80_plus",
              "population.total.age_20_66",
              "population.total.age_67_plus",
              "population.female.all_ages",
              "population.female.age_0_14",
              "population.female.age_15_64",
              "population.female.age_65_plus",
              "population.female.age_80_plus",
              "population.female.age_20_66",
              "population.female.age_67_plus",
              "population.male.all_ages",
              "population.male.age_0_14",
              "population.male.age_15_64",
              "population.male.age_65_plus",
              "population.male.age_80_plus",
              "population.male.age_20_66",
              "population.male.age_67_plus",
              "old_age_dependency_ratio_65plus_per_15_64",
              "old_age_dependency_ratio_67plus_per_20_66",
              "births.total",
              "births.female",
              "births.male",
              "deaths.total",
              "deaths.female",
              "deaths.male",
              "net_migration.total",
              "net_migration.female",
              "net_migration.male",
              "population_by_single_age"
            ]
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "title",
        "baseline_release_id",
        "knowledge_cutoff",
        "model_key",
        "model_version",
        "countries",
        "reference_year",
        "horizon",
        "intervention",
        "assumptions",
        "fidelity",
        "missing_input_policy",
        "outputs",
        "seed"
      ]
    },
    "economic.crude_exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "1.0.0",
            "2.0.0"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseline_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "model_key": {
          "const": "economic.crude_exposure"
        },
        "model_version": {
          "const": "1.0.0"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        },
        "reference_year": {
          "type": "integer",
          "minimum": 2020,
          "maximum": 2024
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periods": {
              "const": 1
            },
            "unit": {
              "const": "annual_accounting_period"
            }
          },
          "required": [
            "periods",
            "unit"
          ]
        },
        "intervention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "set_exogenous_border_price_multiplier"
            },
            "import_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "export_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3
            },
            "unit": {
              "const": "ratio"
            }
          },
          "required": [
            "kind",
            "import_multiplier",
            "export_multiplier",
            "unit"
          ]
        },
        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quantity_response": {
              "enum": [
                "fixed",
                "elasticity_sensitivity"
              ]
            },
            "elasticity_grid": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "import_elasticity": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 1
                  },
                  "export_elasticity": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 2
                  },
                  "basis": {
                    "const": "scenario_assumption"
                  }
                },
                "required": [
                  "import_elasticity",
                  "export_elasticity",
                  "basis"
                ]
              }
            },
            "no_general_equilibrium": {
              "const": true
            }
          },
          "required": [
            "quantity_response",
            "elasticity_grid",
            "no_general_equilibrium"
          ]
        },
        "fidelity": {
          "enum": [
            "L0",
            "L1",
            "L2"
          ]
        },
        "missing_input_policy": {
          "enum": [
            "fail",
            "skip_missing_countries"
          ]
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "import_value_change_usd",
              "export_value_change_usd",
              "net_external_cost_change_usd",
              "exposure_percent_baseline_gdp"
            ]
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "title",
        "baseline_release_id",
        "knowledge_cutoff",
        "model_key",
        "model_version",
        "countries",
        "reference_year",
        "horizon",
        "intervention",
        "assumptions",
        "fidelity",
        "missing_input_policy",
        "outputs",
        "seed"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "1.0.0"
              }
            }
          },
          "then": {
            "properties": {
              "countries": {
                "items": {
                  "enum": [
                    "FRA",
                    "DZA",
                    "CHN",
                    "USA"
                  ]
                },
                "maxItems": 4
              },
              "missing_input_policy": {
                "const": "fail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "countries": {
                "contains": {
                  "const": "ALL"
                }
              }
            }
          },
          "then": {
            "properties": {
              "countries": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "L1"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "properties": {
                  "quantity_response": {
                    "const": "fixed"
                  },
                  "elasticity_grid": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fidelity": {
                "const": "L2"
              }
            }
          },
          "then": {
            "properties": {
              "assumptions": {
                "properties": {
                  "quantity_response": {
                    "const": "elasticity_sensitivity"
                  },
                  "elasticity_grid": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "economic.io_price": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
