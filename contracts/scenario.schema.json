        "assumptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pass_through_grid": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
                  }
                ]
              }
            }
          }
        },
        "fidelity": {
          "enum": [
            "L0",
            "L1",
            "L2"
          ]
        },
        "missing_input_policy": {
