          "properties": {
            "kind": {
              "const": "set_exogenous_industry_price_change"
            },
            "shocks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "origin",
