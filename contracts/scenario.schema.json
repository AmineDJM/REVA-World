    "social.retirement_age": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0.0"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "baseline_release_id": {
          "type": "string",
          "format": "uuid"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "model_key": {
          "const": "social.retirement_age"
        },
        "model_version": {
          "const": "1.0.0"
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "minItems": 1,
          "maxItems": 300,
          "uniqueItems": true
        },
        "reference_year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2039
        },
        "horizon": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periods": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40
            },
            "unit": {
              "const": "calendar_year"
            }
          },
          "required": [
            "periods",
            "unit"
          ]
        },
        "intervention": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "retirement_age_rule_path"
                },
                "scenario_path": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,80}$"
                },
                "reference_path": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,80}$"
                }
              },
              "required": [
                "kind",
                "scenario_path",
                "reference_path"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "retirement_age_shift"
                },
                "reference_path": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]{1,80}$"
                },
                "shift_months": {
                  "type": "integer",
                  "minimum": -60,
                  "maximum": 60
                },
                "first_birth_year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                },
                "phase_in_months_per_cohort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                }
              },
              "required": [
                "kind",
                "reference_path",
                "shift_months",
                "first_birth_year"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Target statutory age LEVEL (months of age, e.g. 780 = 65 years) of the rule table's lever age for cohorts born in first_birth_year or later; earlier cohorts keep the reference path. Use this, not a shift, when the request states an age level.",
              "properties": {
                "kind": {
                  "const": "retirement_age_target"
                },
