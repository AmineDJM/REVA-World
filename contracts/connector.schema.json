{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REVA declarative connector manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "template": {
      "enum": [
        "worldbank_v2",
        "comtrade_public_exact",
        "eurostat_jsonstat",
        "crossref_doi",
        "naturalearth_asset"
      ]
    },
    "source_key": {
      "type": "string"
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+$"
      }
    },
    "dataset": {
      "type": "string"
    },
    "request_parameters": {
      "type": "object"
    },
    "mapping_version": {
      "type": "string"
    },
    "rights_ref": {
      "type": "string"
    },
    "lineage_family": {
      "type": "string"
    },
    "max_response_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52428800
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_interval_seconds": {
          "type": "integer",
          "minimum": 60
        },
        "release_aware": {
          "type": "boolean"
        }
      },
      "required": [
        "minimum_interval_seconds",
        "release_aware"
      ]
    },
    "eligibility_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generation_mode": {
      "const": "declarative_only"
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "template",
    "source_key",
    "allowed_hosts",
    "dataset",
    "request_parameters",
    "mapping_version",
    "rights_ref",
    "lineage_family",
    "max_response_bytes",
    "max_pages",
    "cadence",
    "eligibility_scope",
    "generation_mode"
  ]
}

